from __future__ import annotations

import sys
from typing import Any
from collections.abc import Callable, Awaitable

from ._types import WebsocketMessage
from .http import HTTP1Settings, HTTP2Settings

__version__: str
BUILD_GIL: bool

class App:
    def __init__(
        self,
        on_request: Callable[[Any, Any], None],
        on_websocket: Callable[[Any, Any], None],
    ) -> None: ...

class AbortHandle:
    def __call__(self) -> None: ...

class RSGIHeaders:
    def __contains__(self, key: str) -> bool: ...
    def keys(self) -> list[str]: ...
    def values(self) -> list[str]: ...
    def items(self) -> list[tuple[str, str]]: ...
    def get(self, key: str, default: Any = None) -> Any: ...

class RSGIHTTPReader:
    def read(self, on_data: Callable[[bytes, bool], None]) -> AbortHandle: ...
    def _read_asyncio(self) -> Awaitable[tuple[bytes, bool]]: ...

class RSGIHTTPWriter:
    def write_bytes(self, data: bytes, on_done: Callable[[], None], on_error: Callable[[], None]) -> AbortHandle: ...
    def write_str(self, data: str, on_done: Callable[[], None], on_error: Callable[[], None]) -> AbortHandle: ...
    def _write_asyncio_bytes(self, data: bytes) -> Awaitable[None]: ...
    def _write_asyncio_str(self, data: str) -> Awaitable[None]: ...

class RSGIHTTPProtocol:
    def close(self) -> None: ...
    def read(self, on_data: Callable[[bytes], None], on_error: Callable[[], None]) -> AbortHandle | None: ...
    def reader(self) -> RSGIHTTPReader: ...
    def watch(self, on_disconnect: Callable[[], None]) -> AbortHandle | None: ...
    def write(self, status: int, headers: list[tuple[str, str]]) -> None: ...
    def write_str(self, status: int, headers: list[tuple[str, str]], body: str) -> None: ...
    def write_bytes(self, status: int, headers: list[tuple[str, str]], body: bytes) -> None: ...
    def write_file(self, status: int, headers: list[tuple[str, str]], file: str) -> None: ...
    def write_file_range(
        self, status: int, headers: list[tuple[str, str]], file: str, start: int, end: int
    ) -> None: ...
    def writer(self, status: int, headers: list[tuple[str, str]]) -> RSGIHTTPWriter: ...
    def _read_asyncio(self) -> Awaitable[bytes]: ...
    def _watch_asyncio(self) -> Awaitable[None]: ...

class RSGIWebsocketReader:
    def read(self, on_data: Callable[[WebsocketMessage], None], on_error: Callable[[], None]) -> AbortHandle: ...
    def _read_asyncio(self) -> Awaitable[WebsocketMessage]: ...

class RSGIWebsocketWriter:
    def write_bytes(self, data: bytes, on_done: Callable[[], None], on_error: Callable[[], None]) -> AbortHandle: ...
    def write_str(self, data: str, on_done: Callable[[], None], on_error: Callable[[], None]) -> AbortHandle: ...
    def _write_asyncio_bytes(self, data: bytes) -> Awaitable[None]: ...
    def _write_asyncio_str(self, data: str) -> Awaitable[None]: ...

class RSGIWebsocketProtocol:
    def accept(
        self, on_accepted: Callable[[RSGIWebsocketReader, RSGIWebsocketWriter], None], on_error: Callable[[], None]
    ) -> AbortHandle: ...
    def close(self, status: int | None = None) -> tuple[int, bool]: ...
    def _accept_asyncio(self) -> Awaitable[tuple[RSGIWebsocketReader, RSGIWebsocketWriter]]: ...

class RSGIProtocolError(RuntimeError): ...
class RSGIProtocolClosed(RuntimeError): ...

class WSGIScope:
    def to_environ(self, environ: dict[str, Any]) -> dict[str, Any]: ...

class WorkerSignal:
    def __init__(self) -> None: ...
    def set(self) -> None: ...
    def add_cb(self, cb: Any) -> None: ...

